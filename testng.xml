<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Saucedemo UI and API Automation Suite" verbose="1">

  <listeners>
    <listener class-name="com.qa.framework.listeners.TestListener"/>
  </listeners>

  <test name="UI Tests">
    <classes>
      <class name="com.qa.framework.tests.ui.LoginTests"/>
      <class name="com.qa.framework.tests.ui.ProductTests"/>
      <class name="com.qa.framework.tests.ui.CheckoutTests"/>
    </classes>
  </test>

  <test name="API Tests">
    <classes>
      <class name="com.qa.framework.tests.api.PostsApiTests"/>
      <class name="com.qa.framework.tests.api.UsersApiTests"/>
    </classes>
  </test>

</suite>
